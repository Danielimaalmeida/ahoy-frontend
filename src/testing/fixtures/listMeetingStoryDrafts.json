          "id": "Q1",
          "text": "Should the fee be added automatically, or does finance approve each one first?",
          "options": [
            {
              "label": "Finance approves each fee",
              "detail": "Fewer disputes with big customers; keeps the first version small.",
              "recommended": true
            },
            {
              "label": "Added automatically",
              "detail": "No manual work, but disputes go to account managers.",
              "recommended": false
            }
          ]
        },
        {
          "id": "Q2",
          "text": "When does the fee start?",
          "options": [
            {
              "label": "30 days after the due date",
              "detail": "Matches the reminder emails customers already get.",
              "recommended": true
            },
            {
              "label": "On the due date",
              "detail": "Stricter; expect more complaints.",
              "recommended": false
            },
            {
              "label": "60 days after the due date",
              "detail": "Gentler; slower cash flow.",
              "recommended": false
            }
          ]
        }
